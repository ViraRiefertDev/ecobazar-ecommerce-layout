{
	// Place your ecobazar workspace snippets here. Each snippet is defined under a snippet name and has a scope, prefix, body and 
	// description. Add comma separated ids of the languages where the snippet is applicable in the scope field. If scope 
	// is left empty or omitted, the snippet gets applied to all languages. The prefix is what is 
	// used to trigger the snippet and the body will be expanded and inserted. Possible variables are: 
	// $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders. 
	// Placeholders with the same ids are connected.
	// Example:
	// "Print to console": {
	// 	"scope": "javascript,typescript",
	// 	"prefix": "log",
	// 	"body": [
	// 		"console.log('$1');",
	// 		"$2"
	// 	],
	// 	"description": "Log output to console"
	// }

  "Typography": {
		"scope": "scss",
		"prefix": "typo",
		"body": ["@include typography($1);"],
		"description": "Add typography"
	},

  "ToRem": {
		"scope": "scss",
		"prefix": "tr",
		"body": ["toRem($1)"],
		"description": "Px in Rem"
	},

  
  "Break": {
		"scope": "scss",
		"prefix": "brr",
		"body": [
      "//------------------------------------------------------------------------",
      "$1"],
    
		"description": "Breaks"
	},

  "NotLastChild": {
		"scope": "scss",
		"prefix": "nlc",
		"body": ["&:not(:last-child) {",
      "\tmargin-bottom: toRem($1);",
      "}"],
    
		"description": "NotLastChild"
	},

  "Hover": {
    "scope": "scss",
    "prefix": "hhv",
    "body": [
      "@media (any-hover: hover) and (any-pointer: fine) {",
      "\t&:hover,",
      "\t&:focus-visible {",
      "\t\t$1",
      "\t}",
      "}"
    ],
    "description": "Add hover"
  },

  "MediaDesctop": {
		"scope": "scss",
		"prefix": "md",
		"body": [
      "@media (max-width: toEm($1)) {",
      "\t$2",
      "}"],
    
		"description": "Media Desctop max-width"
	},

  "AdaptiveValue": {
		"scope": "scss",
		"prefix": "av",
		"body": ["@include adaptiveValue('$1',$2,$3);"],
		"description": "adaptive value"
	},
}